# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.pyo

# Build artifacts (if esbuild is run locally)
app/app.js

# Generated by build_seed.py — and rewritten by meal-server.py on EVERY
# /sync.json request, which is why these cannot be tracked: the checkout would
# be permanently dirty and deploy.sh's dirty-checkout guard would refuse every
# time. Both are reproducible from the markdown library in the parent directory.
# See knowledge/instruments.md and program/findings/T0.10.md.
app/seed.json
app/.thumb-cache.json

# Feedback inboxes (runtime data, not source)
feedback-inbox-*.jsonl

# Claude Code local settings (user-specific)
.claude/settings.local.json

# Local dev-server config for the browser pane (machine-specific ports)
.claude/launch.json

# Task worktrees (git plumbing, never source)
.claude/worktrees/

# Editor
.vscode/
*.swp
